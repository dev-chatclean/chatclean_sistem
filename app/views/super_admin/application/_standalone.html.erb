<%# locals: (heading:) -%>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# ChatClean (CCV2-22): nome e logos da configuração da instalação, não os do Chatwoot. %>
    <title>SuperAdmin | <%= ChatcleanBrand.value('INSTALLATION_NAME') %></title>
    <%= render "super_admin/application/theme" %>
    <%= render "super_admin/application/font_preload", file: "Inter/InterVariable.woff2" %>
    <%= render "super_admin/application/font_preload", file: "InterDisplay/InterDisplay-SemiBold.woff2" %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'superadmin.scss' %>
  </head>
  <body class="min-h-full bg-n-background text-n-slate-12 antialiased">
    <div class="fixed inset-x-0 top-0 h-64 bg-pixel-band [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <main class="relative mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-4 py-10">
      <img src="<%= ChatcleanBrand.value('LOGO') %>" alt="<%= ChatcleanBrand.value('INSTALLATION_NAME') %>" class="mx-auto h-8 w-auto dark:hidden">
      <img src="<%= ChatcleanBrand.value('LOGO_DARK') %>" alt="<%= ChatcleanBrand.value('INSTALLATION_NAME') %>" class="mx-auto hidden h-8 w-auto dark:block">
      <h1 class="mt-6 text-center font-interDisplay text-2xl font-semibold tracking-tight"><%= heading %></h1>
      <div class="rounded-xl border border-n-weak bg-n-solid-1 mt-8 p-6 sm:p-8">
        <% if flash[:error].present? %>
          <%= render "super_admin/application/alert", extra: "mb-4" do %>
            <%= flash[:error] %>
          <% end %>
        <% end %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
