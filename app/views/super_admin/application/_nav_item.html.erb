<%# locals: (item:) -%>
<li>
  <%= link_to item[:url],
              class: "group flex min-h-8 items-center gap-2.5 rounded-lg px-2.5 text-body-main text-n-slate-11 transition-colors hover:bg-n-alpha-2 hover:text-n-slate-12 aria-[current=page]:bg-n-alpha-2 aria-[current=page]:font-medium aria-[current=page]:text-n-slate-12 touch:min-h-11 [[data-sidebar=collapsed]_aside_&]:justify-center [[data-sidebar=collapsed]_aside_&]:px-0",
              title: item[:label],
              aria: { current: ("page" if item[:active]) } do %>
    <span class="<%= item[:icon] %> size-4 shrink-0 text-n-slate-10 transition-colors group-hover:text-n-slate-12 group-aria-[current=page]:text-n-brand"></span>
    <span class="truncate [[data-sidebar=collapsed]_aside_&]:hidden"><%= item[:label] %></span>
    <% if item[:external] %>
      <span class="i-lucide-arrow-up-right ms-auto size-3.5 shrink-0 text-n-slate-9 [[data-sidebar=collapsed]_aside_&]:hidden"></span>
    <% end %>
  <% end %>
</li>
