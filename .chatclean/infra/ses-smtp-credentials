#!/usr/bin/env bash
# Credenciais SMTP do SES (CCV2-22). Cria uma chave para o usuário chatclean-ses-smtp (da stack
# chatclean-base), converte a chave secreta na senha SMTP do SES e grava SMTP_USERNAME e
# SMTP_PASSWORD como SecureString em /chatclean/production. Nada secreto aparece na tela.
#
# Uso: .chatclean/infra/ses-smtp-credentials
# Para trocar a senha, rode de novo, faça um deploy e apague a chave antiga
# (aws iam delete-access-key --user-name chatclean-ses-smtp --access-key-id <antiga>).
set -euo pipefail

export AWS_PROFILE="${AWS_PROFILE:-ChatClean}"
export AWS_REGION=sa-east-1
USER_NAME=chatclean-ses-smtp
PARAMETER_PATH=/chatclean/production

key="$(aws iam create-access-key --user-name "$USER_NAME" \
  --query 'AccessKey.[AccessKeyId, SecretAccessKey]' --output text)"
key_id="${key%%$'\t'*}"

# Algoritmo da AWS para a senha SMTP (assinatura SigV4 de "SendRawEmail" com a chave secreta).
# A chave secreta vai pelo stdin, não pela linha de comando.
password="$(printf '%s' "${key#*$'\t'}" | python3 -c '
import base64, hashlib, hmac, sys
secret, region = sys.stdin.read(), sys.argv[1]
signature = ("AWS4" + secret).encode()
for message in ("11111111", region, "ses", "aws4_request", "SendRawEmail"):
    signature = hmac.new(signature, message.encode(), hashlib.sha256).digest()
print(base64.b64encode(bytes([4]) + signature).decode())
' "$AWS_REGION")"
unset key

# Pelo stdin, para os valores não aparecerem na lista de processos. A senha só tem caracteres base64.
put_secret() {
  printf '{"Name": "%s/%s", "Type": "SecureString", "Overwrite": true, "Value": "%s"}' "$PARAMETER_PATH" "$1" "$2" |
    aws ssm put-parameter --cli-input-json file:///dev/stdin > /dev/null
}
put_secret SMTP_USERNAME "$key_id"
put_secret SMTP_PASSWORD "$password"
unset password

echo "==> Credenciais SMTP gravadas em $PARAMETER_PATH (chave $key_id)."
aws iam list-access-keys --user-name "$USER_NAME" --query 'AccessKeyMetadata[].[AccessKeyId, CreateDate]' --output text
