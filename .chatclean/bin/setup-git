#!/bin/sh
# ChatClean: configura remotes e hooks do clone local. Idempotente.
set -e

cd "$(git rev-parse --show-toplevel)"

upstream_url="https://github.com/chatwoot/chatwoot.git"

if git remote get-url upstream >/dev/null 2>&1; then
  git remote set-url upstream "$upstream_url"
else
  git remote add upstream "$upstream_url"
fi
# Nunca enviar nada para o Chatwoot oficial.
git remote set-url --push upstream DISABLE

# Gera .husky/_ (necessario para os hooks do upstream).
if [ -d node_modules/husky ]; then
  pnpm exec husky install >/dev/null
fi

# Os hooks sao copiados para dentro do .git: assim valem em qualquer branch, inclusive na develop
# (espelho do upstream, sem .chatclean/) e em worktrees. Rode de novo quando .chatclean/hooks mudar.
hooks_dir="$(cd "$(git rev-parse --git-common-dir)" && pwd)/chatclean-hooks"
mkdir -p "$hooks_dir"
cp .chatclean/hooks/* "$hooks_dir/"
chmod +x "$hooks_dir"/*
git config core.hooksPath "$hooks_dir"

git fetch upstream --no-tags --quiet

echo "Remotes:"
git remote -v
echo "Hooks: $(git config core.hooksPath)"
