#!/bin/sh
# ChatClean: atualiza develop (espelho do Chatwoot) em fast-forward, local e no origin.
# A main nao e tocada: o upstream chega nela por Pull Request develop -> main.
set -e

cd "$(git rev-parse --show-toplevel)"

git fetch upstream --no-tags --quiet
git fetch origin --quiet

if ! git merge-base --is-ancestor origin/develop upstream/develop; then
  echo "[ChatClean] origin/develop divergiu de upstream/develop (fast-forward impossivel)."
  echo "develop e espelho e nao deve ter commits proprios. Alinhe antes de criar features:"
  echo "  git switch develop && git reset --hard upstream/develop && git push --force-with-lease origin develop"
  exit 1
fi

if [ "$(git rev-parse --abbrev-ref HEAD)" = "develop" ]; then
  git merge --ff-only upstream/develop
else
  git fetch . upstream/develop:develop
fi
git push origin refs/remotes/upstream/develop:refs/heads/develop

echo "develop = $(git rev-parse --short develop) ($(git log -1 --format=%s develop))"
echo "Commits do upstream ainda fora da main: $(git rev-list --count origin/main..develop)"
echo "Para integrar: abra um PR develop -> main."
