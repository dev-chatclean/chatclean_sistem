# HTTPS automático (Let's Encrypt) para o domínio do ChatClean (CCV2-19). O Caddy repassa
# WebSocket (/cable) e os cabeçalhos X-Forwarded-*, e tenta de novo a emissão do certificado
# enquanto o DNS não propagar. Com CHATCLEAN_DOMAIN=localhost (teste local), usa um certificado interno.
{$CHATCLEAN_DOMAIN} {
	encode zstd gzip
	reverse_proxy rails:3000

	# Log de acesso em JSON, lido pelo CloudWatch Agent para o alarme de erros 5xx (CCV2-22).
	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# HTTP vai para HTTPS com 301 (o redirecionamento automático do Caddy seria 308). O desafio
# ACME na porta 80 continua sendo atendido pelo Caddy antes deste bloco.
http://{$CHATCLEAN_DOMAIN} {
	redir https://{host}{uri} 301
}
