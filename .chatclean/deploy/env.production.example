# Modelo do .env de produção (CCV2-20). No servidor, o deploy gera o .env a partir do
# SSM Parameter Store (/chatclean/production/*); nada disto vai para o repositório preenchido.
# Valores marcados com SSM são segredos (SecureString).

# Aplicação
CHATCLEAN_DOMAIN=chat.chatclean.com.br
FRONTEND_URL=https://chat.chatclean.com.br
SECRET_KEY_BASE=                     # SSM; gerar com: openssl rand -hex 64
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DISABLE_TELEMETRY=true

# Banco (container postgres da própria máquina)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=chatclean
POSTGRES_PASSWORD=                   # SSM
POSTGRES_DATABASE=chatclean_production

# Redis (container redis da própria máquina)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=                      # SSM

# Anexos no S3 (CCV2-21): a máquina acessa pela IAM Role, sem chave fixa
ACTIVE_STORAGE_SERVICE=amazon
AWS_REGION=sa-east-1
S3_BUCKET_NAME=chatclean-attachments-production

# E-mail pelo Amazon SES (CCV2-22)
MAILER_SENDER_EMAIL=ChatClean <desenvolvimento@chatclean.com.br>
SMTP_ADDRESS=email-smtp.sa-east-1.amazonaws.com
SMTP_PORT=587
SMTP_DOMAIN=chatclean.com.br
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_USERNAME=                       # SSM (credencial SMTP do SES)
SMTP_PASSWORD=                       # SSM
